root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{f90,F90}]
indent_style = space
indent_size = 3

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{md,rst}]
trim_trailing_whitespace = false

[*.{tla,cfg}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
